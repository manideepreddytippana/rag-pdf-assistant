# ==========================================
# RAG PDF Assistant - Environment Configuration
# ==========================================

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/rag_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# LLM API Configuration
API_KEY=your_api_key_here
API_BASE_URL=https://api.sarvam.ai/v1/
LLM_MODEL=sarvam-105b
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# Embedding & Reranker Models
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Chunking Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval & Reranker Thresholds
TOP_K=5
INITIAL_TOP_K=20
EMBEDDING_THRESHOLD=0.35
RERANKER_THRESHOLD=0.25

# Memory & Conversation Limits
MAX_HISTORY_TURNS=2
MAX_ASSISTANT_CHARS=150

# Document & Storage Paths
PDF_FILENAME=netflix.pdf

# Server Configuration
SERVER_PORT=8000
